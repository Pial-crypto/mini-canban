generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 
}

enum BoardRole {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  password         String
  name             String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
}
